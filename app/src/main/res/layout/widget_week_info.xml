<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/week_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_brew_background" android:padding="16dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/week_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_hero_text" android:textSize="36sp"/><TextView android:id="@+id/week_brew_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="@color/widget_secondary_text" android:textSize="14sp"/></LinearLayout>
        <TextView android:id="@+id/week_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_secondary_text" android:textSize="13sp" />
        <TextView android:id="@+id/week_empty_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_secondary_text" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4" android:orientation="vertical">
    <ImageView android:id="@+id/week_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@null" android:scaleType="fitXY" />
    <LinearLayout android:id="@+id/week_days" android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal">
        <TextView android:id="@+id/week_day_0" style="@style/WeekDay"/><TextView android:id="@+id/week_day_1" style="@style/WeekDay"/><TextView android:id="@+id/week_day_2" style="@style/WeekDay"/><TextView android:id="@+id/week_day_3" style="@style/WeekDay"/><TextView android:id="@+id/week_day_4" style="@style/WeekDay"/><TextView android:id="@+id/week_day_5" style="@style/WeekDay"/><TextView android:id="@+id/week_day_6" style="@style/WeekDay"/>
    </LinearLayout></LinearLayout>
</LinearLayout>
