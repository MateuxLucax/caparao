<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/analytics_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_brew_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/analytics_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/analytics_widget_name"
        android:textColor="@color/widget_secondary_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/analytics_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/analytics_widget_empty"
        android:textColor="@color/widget_primary_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/analytics_widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/analytics_widget_caffeine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_primary_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/analytics_widget_bedtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_secondary_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/analytics_widget_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:textColor="@color/widget_primary_text"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/analytics_widget_curve"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/analytics_widget_curve_description"
            android:scaleType="fitXY" />
    </LinearLayout>
</LinearLayout>
