<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_brew_background"
    android:gravity="center_vertical"
    android:minHeight="134dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_secondary_text"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/widget_last_brew"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_primary_text"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/widget_secondary_text"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_empty_text"
        android:textColor="@color/widget_secondary_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_primary_text"
        android:textSize="14sp"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_action_background"
        android:gravity="center"
        android:minHeight="38dp"
        android:paddingHorizontal="12dp"
        android:textColor="@color/widget_action_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
