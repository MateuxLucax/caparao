<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_brew_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_last_brew_title"
        android:textColor="@color/widget_secondary_text"
        android:includeFontPadding="false"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_coffee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_preview_coffee"
        android:textColor="@color/widget_primary_text"
        android:includeFontPadding="false"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_method"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:text="@string/widget_preview_brew_details"
        android:textColor="@color/widget_secondary_text"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:includeFontPadding="false"
        android:text="@string/widget_preview_time"
        android:textColor="@color/widget_secondary_text"
        android:textSize="9sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_action_background"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_action_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:text="@string/widget_brew_filter"
            android:textColor="@color/widget_action_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
