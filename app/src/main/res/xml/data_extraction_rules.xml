<?xml version="1.0" encoding="utf-8"?>
<!--
    Keep app data out of cloud backups and device-to-device transfers: the settings will hold the
    server token, and brews are personal data that only go to the server the user configures.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="diagnostics/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="diagnostics/" />
    </device-transfer>
</data-extraction-rules>
