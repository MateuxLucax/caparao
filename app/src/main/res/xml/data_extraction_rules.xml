<?xml version="1.0" encoding="utf-8"?>
<!--
    Keep app data out of cloud backups and device-to-device transfers: the settings hold the server
    token, brews are personal data, and replay captures are only sent after opt-in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="captures/" />
        <exclude domain="file" path="diagnostics/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="captures/" />
        <exclude domain="file" path="diagnostics/" />
    </device-transfer>
</data-extraction-rules>
