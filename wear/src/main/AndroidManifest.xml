<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- The Ongoing Activity during a brew (BrewOngoingService). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The guide's alerts (AlertListenerService). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/launcher_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Needs the phone app: the watch only mirrors it (docs/adr/0023-watch-companion.md). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".WatchActivity"
            android:exported="true"
            android:taskAffinity=""
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Opened by the phone when a brew starts (RemoteActivityHelper, WatchPaths.OPEN_URI). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="caparao" android:host="watch" />
            </intent-filter>
        </activity>

        <!-- The phone's guide alerts, also with the app closed (WatchPaths.ALERT). -->
        <service
            android:name=".AlertListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/caparao/alert"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <service
            android:name=".BrewOngoingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mirrors a coffee brew running on the paired phone as a Wear OS Ongoing Activity" />
        </service>
    </application>
</manifest>
